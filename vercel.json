{
  "rewrites": [
    { "source": "/robots.txt",                "destination": "{BLOB_BASE}/tenants/{slug}/robots.txt" },
    { "source": "/sitemap.xml",               "destination": "{BLOB_BASE}/tenants/{slug}/sitemap.xml" },
    { "source": "/llms.txt",                  "destination": "{BLOB_BASE}/tenants/{slug}/llms.txt" },
    { "source": "/mcp-manifest.json",         "destination": "{BLOB_BASE}/tenants/{slug}/mcp-manifest.json" },
    { "source": "/mcp-manifests/:path*.json", "destination": "{BLOB_BASE}/tenants/{slug}/mcp-manifests/:path*.json" },
    { "source": "/:path*.json",               "destination": "{BLOB_BASE}/tenants/{slug}/pages/:path*.json" },
    { "source": "/(.*)",                      "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}